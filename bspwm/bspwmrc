#!/bin/sh

# ==========================================
# BSPWM
# ==========================================

# Workspaces
bspc monitor -d I II III IV V VI VII VIII IX X

# Window geometry
bspc config border_width 2
bspc config window_gap 10
bspc config split_ratio 0.50

# Window behaviour
bspc config borderless_monocle false
bspc config gapless_monocle false
bspc config single_monocle false
bspc config focus_follows_pointer false
bspc config pointer_follows_focus true
bspc config automatic_scheme alternate
bspc config initial_polarity second
bspc config auto_cancel true
bspc config auto_balance false

# Tokyo Night borders
bspc config normal_border_color "#414868"
bspc config active_border_color "#565f89"
bspc config focused_border_color "#7aa2f7"
bspc config presel_feedback_color "#bb9af7"

# ==========================================
# AUTOSTART
# ==========================================

# sxhkd
pgrep -x sxhkd >/dev/null || sxhkd &

# Picom
pgrep -x picom >/dev/null || \
    picom --config "$HOME/.config/picom/picom.conf" &

# Polybar
pkill -x polybar 2>/dev/null
polybar main &

# Wallpaper
[ -f "$HOME/.fehbg" ] && "$HOME/.fehbg" &

# Cursor
xsetroot -cursor_name left_ptr
